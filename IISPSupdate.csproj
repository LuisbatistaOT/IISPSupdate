<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;publish\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <!-- EF Tools (dotnet ef) are used as a global tool for migrations; do not reference here to avoid CodeAnalysis conflict with PowerShell.SDK -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.12" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.12" />
    <!-- Single SDK package: brings in System.Management.Automation and all PowerShell snap-ins (ConsoleHost, Diagnostics, Utility, Management, etc.) so publish has every required DLL -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.13" />
      </ItemGroup>

  <ItemGroup>
    <Content Update="Webpage\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyWebpageAssets" AfterTargets="Publish">
    <ItemGroup>
      <WebpageFiles Include="Webpage\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebpageFiles)"
          DestinationFiles="@(WebpageFiles->'$(PublishDir)Webpage\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
