@model IISPSupdate.Models.Project
@{
    ViewData["Title"] = $"Project {Model.Id}: {Model.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Project @Model.Id: @Model.Name</h2>
        <div class="text-muted small">
            Scan source: @(ViewBag.ScanSourceDisplay ?? Model.ScanSource.ToString()) | Created by @Model.CreatedBy on @Model.CreatedAtUtc.ToLocalTime()
        </div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Projects</a>
</div>

<ul class="nav nav-tabs mb-3" id="wizardTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="servers-tab" data-bs-toggle="tab" data-bs-target="#servers-panel" type="button" role="tab">1. Servers</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="scan-tab" data-bs-toggle="tab" data-bs-target="#scan-panel" type="button" role="tab">2. Pre-flight &amp; Scan</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="select-tab" data-bs-toggle="tab" data-bs-target="#select-panel" type="button" role="tab">3. Select KBs</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="run-tab" data-bs-toggle="tab" data-bs-target="#run-panel" type="button" role="tab">4. Run</button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="servers-panel" role="tabpanel" aria-labelledby="servers-tab">
        <div class="card shadow-sm mb-3">
            <div class="card-header">
                Upload / paste servers
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    Paste one server per line, or CSV <code>Name,Fqdn,Environment</code>. Optional header row is supported.
                </p>
                <div class="row">
                    <div class="col-md-8">
                        <textarea id="serversText" class="form-control monospace" rows="8" placeholder="server01
server02.domain.local,server02.domain.local,Prod"></textarea>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="hasHeader">
                            <label class="form-check-label" for="hasHeader">
                                First line is a header row
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-primary mb-2" type="button" onclick="importServers()">Import servers</button>
                        <button class="btn btn-outline-secondary mb-2" type="button" onclick="goToScanStep()">Next: Pre-flight &amp; Scan</button>
                        <div id="serversStatus" class="small text-muted"></div>
                        <hr />
                        <h6>Current servers</h6>
                        <ul class="list-unstyled" id="serversList">
                            @foreach (var s in Model.Servers.OrderBy(s => s.Name))
                            {
                                <li>@s.Name (@s.Environment)</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="scan-panel" role="tabpanel" aria-labelledby="scan-tab">
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Pre-flight (DNS/WinRM) &amp; Scan</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" type="button" onclick="downloadScanReport()">Download scan report</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" id="btnNextToSelect" onclick="goToSelectStep()">Next: Select KBs</button>
                    <button class="btn btn-sm btn-primary" type="button" id="btnStartScan" onclick="startScan()">Start scan</button>
                </div>
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    This runs WinRM pre-flight checks and then a single PSWindowsUpdate scan against each server.
                    Important: scan results may list KB candidates, but installs are blocked for any server with failed pre-flight until connectivity is fixed.
                </p>
                <div id="scanStatus" class="small mb-2 text-muted"></div>
                <div id="scanLoading" class="mb-2" style="display: none;">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Scanning…</span>
                </div>
                <div id="preflightInstallWarning" class="alert alert-warning py-2 small" style="display: none;"></div>
                <table class="table table-sm align-middle" id="scanTable">
                    <thead>
                        <tr>
                            <th>Server</th>
                            <th>Pre-flight</th>
                            <th>Last scan</th>
                            <th>KBs available</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- filled by JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="select-panel" role="tabpanel" aria-labelledby="select-tab">
        <div class="card shadow-sm mb-3">
            <div class="card-header">
                Select KBs
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    Build the update package for this project. You can add KBs manually or load KB candidates from the latest scan.
                    The selected KB list is applied to <strong>all servers in this project</strong>.
                </p>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">KB input</label>
                        <div class="input-group">
                            <input type="text" id="kbInput" class="form-control monospace" placeholder="KB5035853, KB5035855" />
                            <button type="button" id="btnAddKbs" class="btn btn-primary" onclick="addKbFromInput()">Add KBs</button>
                        </div>
                        <div class="form-text">Use comma, semicolon, or whitespace as separator.</div>
                    </div>
                    <div class="col-md-4 d-flex flex-column gap-2">
                        <button type="button" class="btn btn-outline-primary" id="btnSaveSelection" onclick="saveSelection()">Save selection</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="loadCandidates()">Load candidates from latest scan</button>
                        <button type="button" class="btn btn-outline-secondary" id="btnClearSelection" onclick="clearSelection()">Clear selection</button>
                    </div>
                </div>
                <div class="mt-3">
                    <h6>Selected KB summary</h6>
                    <table class="table table-sm align-middle" id="selectedKbTable">
                        <thead>
                            <tr>
                                <th>KB</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Recommended</th>
                                <th>Source</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div id="candidateContainer" class="small text-muted"></div>
                </div>
                <div class="mt-3 p-3 border rounded bg-light" id="selectionAnalysis" style="display:none;">
                    <h6 class="mb-2">Selection analysis</h6>
                    <div id="selectionAnalysisContent" class="small"></div>
                </div>
                <div class="mt-3 d-flex justify-content-end">
                    <button type="button" class="btn btn-success" id="btnAnalyzeContinue" onclick="analyzeOrContinue()">Analyze and lock selection</button>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="run-panel" role="tabpanel" aria-labelledby="run-tab">
        <div class="card shadow-sm mb-3">
            <div class="card-header">
                Run options
            </div>
            <div class="card-body">
                <form asp-action="StartRun" method="post" class="row g-3">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="col-md-3">
                        <label class="form-label">Max concurrency</label>
                        <input type="number" name="maxConcurrency" class="form-control" min="1" max="50" value="50" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Allow reboot</label>
                        <select name="allowReboot" class="form-select">
                            <option value="true" selected>Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Online only</label>
                        <select name="onlineOnly" class="form-select">
                            <option value="true" selected>Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Error policy</label>
                        <select name="errorPolicy" class="form-select">
                            <option value="StopOnError" selected>Stop on first error</option>
                            <option value="ContinueOnError">Continue on error</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Schedule (UTC, optional)</label>
                        <input type="datetime-local" name="scheduledForUtc" class="form-control" />
                        <div class="form-text">
                            If empty, run starts immediately. Use UTC for predictable scheduling.
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-between">
                        <div class="text-muted small">
                            Concurrency is capped at 50 worker threads by the Hangfire server.
                        </div>
                        <button type="submit" class="btn btn-success">Start run</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const projectId = @Model.Id;
        let scanInProgress = false;
        let pollTimer = null;
        let latestScanItems = [];
        let selectionLocked = false;
        let analysisStageDone = false;
        const selectedKbMap = new Map(); // key: KB, value: {kb,title,category,source}

        document.addEventListener('DOMContentLoaded', function() {
            pollScanResults(true);
            renderSelectedKbTable();
        });

        async function importServers() {
            const content = document.getElementById('serversText').value;
            const hasHeader = document.getElementById('hasHeader').checked;
            const statusEl = document.getElementById('serversStatus');

            statusEl.textContent = 'Importing...';

            const response = await fetch(`/api/projects/${projectId}/servers/import`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ content, hasHeader })
            });

            if (!response.ok) {
                statusEl.textContent = 'Import failed.';
                return;
            }

            const data = await response.json();
            statusEl.textContent = `Imported. Project now has ${data.serverCount ?? data.ServerCount} servers.`;
            setTimeout(function() { goToScanStep(); location.reload(); }, 500);
        }

        function goToScanStep() {
            const scanTabEl = document.querySelector('#scan-tab');
            if (!scanTabEl) return;
            const tab = bootstrap.Tab.getOrCreateInstance(scanTabEl);
            tab.show();
        }

        function goToSelectStep() {
            const selectTabEl = document.querySelector('#select-tab');
            if (!selectTabEl || selectTabEl.classList.contains('wizard-tab-disabled')) return;
            const tab = bootstrap.Tab.getOrCreateInstance(selectTabEl);
            tab.show();
        }

        function goToRunStep() {
            const runTabEl = document.querySelector('#run-tab');
            if (!runTabEl || runTabEl.classList.contains('wizard-tab-disabled')) return;
            const tab = bootstrap.Tab.getOrCreateInstance(runTabEl);
            tab.show();
        }

        function downloadScanReport() {
            window.open(`/api/projects/${projectId}/scan/export`, '_blank');
        }

        async function startScan() {
            const btn = document.getElementById('btnStartScan');
            const statusEl = document.getElementById('scanStatus');
            const loadingEl = document.getElementById('scanLoading');
            if (scanInProgress || !btn) return;

            btn.disabled = true;
            scanInProgress = true;
            loadingEl.style.display = 'block';
            statusEl.textContent = 'Enqueuing scan job…';

            const response = await fetch(`/api/projects/${projectId}/scan`, { method: 'POST' });
            if (!response.ok) {
                statusEl.textContent = 'Failed to enqueue scan.';
                btn.disabled = false;
                scanInProgress = false;
                loadingEl.style.display = 'none';
                return;
            }

            statusEl.textContent = 'Scan enqueued. Updating results…';
            pollScanResults(false);
        }

        function renderScanTable(items) {
            const tbody = document.querySelector('#scanTable tbody');
            const warningEl = document.getElementById('preflightInstallWarning');
            if (!tbody) return;
            tbody.innerHTML = '';
            let blockedCount = 0;
            items.forEach(item => {
                const lastScan = item.lastScan || item.LastScan;
                const preFlightStatus = item.preFlightStatus ?? item.PreFlightStatus;
                const availableCount = item.availableKbCount ?? item.AvailableKbCount ?? 0;
                const availableKbs = item.availableKbs ?? item.AvailableKbs ?? [];
                let notes = item.preFlightError ?? '';
                if (preFlightStatus === 'Failed') {
                    blockedCount += 1;
                    const reason = notes ? `${notes} ` : '';
                    notes = `${reason}Install is blocked for this server until WinRM pre-flight succeeds.`;
                }
                if (!notes && lastScan) {
                    const kbText = availableKbs.length ? ` [${availableKbs.join(', ')}]` : '';
                    notes = availableCount > 0
                        ? `Scan found ${availableCount} KB update(s).${kbText}`
                        : 'Scan completed. No updates found.';
                }

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${item.name ?? item.Name}</td>
                    <td>${preFlightStatus}</td>
                    <td>${lastScan ? new Date(lastScan.scanTimeUtc || lastScan.ScanTimeUtc).toLocaleString() : ''}</td>
                    <td title="${availableKbs.join(', ')}">${availableCount}</td>
                    <td>${notes}</td>`;
                tbody.appendChild(tr);
            });

            if (!warningEl) return;
            if (blockedCount > 0) {
                warningEl.style.display = 'block';
                warningEl.textContent = `${blockedCount} server(s) have failed pre-flight. Those servers cannot be updated even if scan results show available KBs.`;
                return;
            }

            warningEl.style.display = 'none';
            warningEl.textContent = '';
        }

        async function pollScanResults(oneShot) {
            const statusEl = document.getElementById('scanStatus');
            const loadingEl = document.getElementById('scanLoading');
            const btn = document.getElementById('btnStartScan');

            try {
                const response = await fetch(`/api/projects/${projectId}/scan`);
                if (!response.ok) {
                    statusEl.textContent = 'Failed to retrieve scan results.';
                    if (btn) btn.disabled = false;
                    scanInProgress = false;
                    if (loadingEl) loadingEl.style.display = 'none';
                    return;
                }

                const items = await response.json();
                latestScanItems = items;
                renderScanTable(items);
                updateWizardPhases(items);

                const allDone = items.length === 0 || items.every(i => {
                    const st = i.preFlightStatus ?? i.PreFlightStatus;
                    return st === 'Success' || st === 'Failed';
                });
                if (scanInProgress && allDone) {
                    scanInProgress = false;
                    if (btn) btn.disabled = false;
                    if (loadingEl) loadingEl.style.display = 'none';
                    statusEl.textContent = 'Scan completed. Last updated at ' + new Date().toLocaleTimeString();
                    if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
                    updateWizardPhases(items);
                    return;
                }

                if (oneShot) {
                    statusEl.textContent = items.length ? 'Last updated at ' + new Date().toLocaleTimeString() : 'Add servers and run a scan.';
                    return;
                }

                statusEl.textContent = 'Last updated at ' + new Date().toLocaleTimeString();
                pollTimer = setTimeout(function() { pollScanResults(false); }, 3000);
            } catch {
                statusEl.textContent = 'Error while polling scan results.';
                if (btn) btn.disabled = false;
                scanInProgress = false;
                if (loadingEl) loadingEl.style.display = 'none';
            }
        }

        async function loadCandidates() {
            if (selectionLocked) return;
            const container = document.getElementById('candidateContainer');
            container.textContent = 'Loading candidates from last scan…';

            try {
                const response = await fetch(`/api/projects/${projectId}/scan`);
                if (!response.ok) {
                    container.textContent = 'Failed to load scan info.';
                    return;
                }

                const items = await response.json();
                const hasAnyScan = items.some(item => item.lastScan != null);
                const metadata = collectCandidateMetadata(items);
                const entries = Object.values(metadata).sort((a, b) => b.count - a.count).slice(0, 200);
                container.innerHTML = '';

                if (!hasAnyScan) {
                    container.textContent = 'Run a scan first.';
                    return;
                }
                if (!entries.length) {
                    container.textContent = 'Scan found no updates to install.';
                    return;
                }

                entries.forEach(item => {
                    selectedKbMap.set(item.kb, {
                        kb: item.kb,
                        title: item.title || 'From scan result',
                        category: item.category || 'Uncategorized',
                        source: 'Scan'
                    });
                });

                renderSelectedKbTable();
                container.textContent = `Loaded ${entries.length} KB(s) from latest scan.`;
            } catch {
                container.textContent = 'Error while loading candidates.';
            }
        }

        function collectCandidateMetadata(items) {
            const map = {};
            items.forEach(item => {
                const lastScan = item.lastScan || item.LastScan;
                if (!lastScan) return;
                const candidates = lastScan.candidates || lastScan.Candidates || [];
                candidates.forEach(c => {
                    const kb = (c.kbNumber || c.KbNumber || '').toUpperCase().trim();
                    if (!kb) return;
                    if (!map[kb]) {
                        map[kb] = {
                            kb,
                            title: c.title || c.Title || '',
                            category: c.category || c.Category || '',
                            count: 0
                        };
                    }
                    map[kb].count += 1;
                });
            });
            return map;
        }

        function normalizeKb(token) {
            if (!token) return '';
            const trimmed = token.toUpperCase().replace(/[^A-Z0-9]/g, '');
            if (!trimmed) return '';
            if (trimmed.startsWith('KB')) return trimmed;
            if (/^\d+$/.test(trimmed)) return `KB${trimmed}`;
            return trimmed;
        }

        function addKbFromInput() {
            if (selectionLocked) return;
            const input = document.getElementById('kbInput');
            const container = document.getElementById('candidateContainer');
            const raw = (input?.value || '').trim();
            if (!raw) return;

            const tokens = raw.split(/[\s,;\n\r\t]+/).map(normalizeKb).filter(Boolean);
            if (!tokens.length) {
                container.textContent = 'No valid KB values found in input.';
                return;
            }

            tokens.forEach(kb => {
                if (!selectedKbMap.has(kb)) {
                    selectedKbMap.set(kb, {
                        kb,
                        title: 'Manual entry',
                        category: 'Manual',
                        source: 'Manual'
                    });
                }
            });

            if (input) input.value = '';
            renderSelectedKbTable();
            container.textContent = `Added ${tokens.length} KB value(s).`;
        }

        function clearSelection() {
            if (selectionLocked) return;
            selectedKbMap.clear();
            renderSelectedKbTable();
            const container = document.getElementById('candidateContainer');
            container.textContent = 'Selection cleared.';
        }

        function getRecommendation(entry) {
            const combined = `${entry.title || ''} ${entry.category || ''}`.toLowerCase();
            if (/(office|preview|driver|qol|optional|feature pack|language pack)/i.test(combined)) {
                return 'Not recommended';
            }
            if (/(security|critical|cumulative|servicing stack|definition|quality)/i.test(combined)) {
                return 'Recommended';
            }
            return 'Review';
        }

        function renderSelectedKbTable() {
            const tbody = document.querySelector('#selectedKbTable tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const entries = Array.from(selectedKbMap.values()).sort((a, b) => a.kb.localeCompare(b.kb));
            entries.forEach(entry => {
                const recommendation = getRecommendation(entry);
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${entry.kb}</td>
                    <td>${entry.title || ''}</td>
                    <td>${entry.category || ''}</td>
                    <td>${recommendation}</td>
                    <td>${entry.source}</td>
                    <td>${selectionLocked ? '' : `<button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSelectedKb('${entry.kb}')">X</button>`}</td>`;
                tbody.appendChild(tr);
            });
        }

        function removeSelectedKb(kb) {
            if (selectionLocked) return;
            selectedKbMap.delete(kb);
            renderSelectedKbTable();
        }

        async function saveSelection() {
            const container = document.getElementById('candidateContainer');
            const serverIds = latestScanItems.map(s => s.serverId ?? s.ServerId).filter(Boolean);
            const entries = Array.from(selectedKbMap.values());

            if (!entries.length) {
                container.textContent = 'Add or load at least one KB first.';
                return false;
            }
            if (!serverIds.length) {
                container.textContent = 'No servers found in project. Import servers first.';
                return false;
            }

            const payload = [];
            serverIds.forEach(serverId => {
                entries.forEach(entry => {
                    payload.push({
                        projectServerId: serverId,
                        kbNumber: entry.kb,
                        title: entry.title || entry.kb,
                        category: entry.category || null
                    });
                });
            });

            const response = await fetch(`/api/projects/${projectId}/selections`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                container.textContent = 'Failed to save KB selection.';
                return false;
            }

            container.textContent = `Saved ${entries.length} KB(s) for ${serverIds.length} server(s).`;
            return true;
        }

        async function analyzeOrContinue() {
            const button = document.getElementById('btnAnalyzeContinue');
            const analysisBox = document.getElementById('selectionAnalysis');
            const analysisContent = document.getElementById('selectionAnalysisContent');

            if (analysisStageDone) {
                goToRunStep();
                return;
            }

            const saved = await saveSelection();
            if (!saved) return;

            const entries = Array.from(selectedKbMap.values());
            const notRecommended = entries.filter(e => getRecommendation(e) === 'Not recommended');
            const likelyRestart = entries.some(e => !/definition/i.test((e.category || '').toLowerCase()));
            const estimatedGb = Math.max(0.2, entries.length * 0.65).toFixed(1);
            const estimatedMinutes = Math.max(10, entries.length * 6);

            analysisContent.innerHTML = `
                <div><strong>Total KBs selected:</strong> ${entries.length}</div>
                <div><strong>Estimated download size:</strong> ~${estimatedGb} GB</div>
                <div><strong>Estimated install time:</strong> ~${estimatedMinutes} minutes (environment dependent)</div>
                <div><strong>Potentially not recommended:</strong> ${notRecommended.length}</div>
                <div><strong>Likely restart required:</strong> ${likelyRestart ? 'Yes' : 'No'}</div>
                <div class="mt-2"><strong>Not recommended KBs:</strong> ${notRecommended.map(x => x.kb).join(', ') || 'None'}</div>`;

            analysisBox.style.display = 'block';

            selectionLocked = true;
            analysisStageDone = true;
            ['kbInput', 'btnAddKbs', 'btnSaveSelection', 'btnClearSelection'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.disabled = true;
            });

            button.textContent = 'Continue to Run';
        }

        function updateWizardPhases(items) {
            const hasServers = items.length > 0;
            const scanComplete = hasServers && items.every(i => {
                const st = i.preFlightStatus ?? i.PreFlightStatus;
                return st === 'Success' || st === 'Failed';
            });
            const nextBtn = document.getElementById('btnNextToSelect');
            if (nextBtn) {
                nextBtn.disabled = !scanComplete;
            }
            document.querySelectorAll('#wizardTabs .nav-link').forEach((el, idx) => {
                const tabId = el.getAttribute('data-bs-target');
                if (!tabId) return;
                const isServers = tabId === '#servers-panel';
                const isScan = tabId === '#scan-panel';
                const isSelect = tabId === '#select-panel';
                const isRun = tabId === '#run-panel';
                const allow = isServers || (isScan && hasServers) || ((isSelect || isRun) && scanComplete);
                el.classList.toggle('wizard-tab-disabled', !allow);
                el.style.pointerEvents = allow ? '' : 'none';
            });
        }
    </script>
}

