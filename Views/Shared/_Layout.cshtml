@{
    var title = ViewData["Title"] as string ?? "PS Patch Orchestrator";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <link rel="icon" type="image/jpeg" href="/assets/favicon" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
        body {
            padding-top: 4.5rem;
        }

        .navbar-brand {
            font-weight: 600;
            letter-spacing: 0.03em;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
        }

        .brand-logo { height: 24px; width: auto; }

        .wizard-step {
            padding: .75rem 1rem;
            border-bottom: 3px solid transparent;
            cursor: pointer;
        }

        .wizard-step.active {
            border-bottom-color: #0d6efd;
            font-weight: 600;
        }

        .status-pill {
            display: inline-block;
            padding: .25rem .75rem;
            border-radius: 999px;
            font-size: .75rem;
        }

        .status-pill-success {
            background-color: #d1e7dd;
            color: #0f5132;
        }

        .status-pill-failed {
            background-color: #f8d7da;
            color: #842029;
        }

        .status-pill-running {
            background-color: #cff4fc;
            color: #055160;
        }

        .monospace {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        }

        .wizard-tab-disabled {
            opacity: 0.5;
            color: #6c757d !important;
        }
    </style>
    @RenderSection("Head", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="/assets/logo" alt="PS Patch Orchestrator" class="brand-logo" />
                <span>PS Patch Orchestrator</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Projects" asp-action="Index">Projects</a>
                    </li>
                </ul>
                <span class="navbar-text text-light">
                    @User?.Identity?.Name
                </span>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

